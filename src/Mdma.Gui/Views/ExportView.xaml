<UserControl x:Class="Mdma.Gui.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="Auto"/> <!-- Task Summary Card -->
            <RowDefinition Height="Auto"/> <!-- Output Path Card -->
            <RowDefinition Height="Auto"/> <!-- Progress / Status Card -->
            <RowDefinition Height="Auto"/> <!-- Action Button -->
            <RowDefinition Height="*"/>    <!-- Result Banner -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Export Task to Package" FontSize="22" FontWeight="Bold" Foreground="#212529"/>
            <TextBlock Text="Package download bytes and metadata into a portable .mdma file" Foreground="#6C757D" FontSize="13"/>
        </StackPanel>

        <!-- Task Summary Card -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="SELECTED TASK" FontSize="11" FontWeight="Bold" Foreground="#6C757D" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Task.Filename}" FontSize="16" FontWeight="SemiBold" Foreground="#212529"/>
                        <TextBlock Text="{Binding Task.Url}" Foreground="#6C757D" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Task.Source}" FontWeight="Bold" Foreground="#2B2D42" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Task.StatusText}" Foreground="#495057" FontSize="12" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Output Path Picker Card -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="DESTINATION PACKAGE PATH" FontSize="11" FontWeight="Bold" Foreground="#6C757D" Margin="0,0,0,8"/>
                <DockPanel>
                    <Button Content="Browse..." Click="BrowseDestination_Click" DockPanel.Dock="Right" Padding="15,6" Background="#6C757D" Foreground="White" BorderThickness="0" Margin="10,0,0,0" Cursor="Hand"/>
                    <TextBox Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Progress Card -->
        <Border Grid.Row="3" Background="White" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15"
                Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0:F0}%'}" DockPanel.Dock="Right" FontWeight="Bold" Foreground="#2B2D42"/>
                    <TextBlock Text="{Binding ProgressStage}" FontWeight="SemiBold" Foreground="#212529"/>
                </DockPanel>
                <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" IsIndeterminate="False"/>
                <TextBlock Text="{Binding ProgressDetail}" Foreground="#6C757D" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Export Action Button -->
        <Button Grid.Row="4" Content="🚀 Export to .mdma Package" Command="{Binding ExportCommand}"
                Padding="20,10" Background="#2B2D42" Foreground="White" BorderThickness="0"
                FontWeight="Bold" FontSize="14" HorizontalAlignment="Left" Cursor="Hand" Margin="0,0,0,15"/>

        <!-- Result Banner -->
        <Border Grid.Row="5" CornerRadius="6" Padding="15" VerticalAlignment="Top"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#D4EDDA"/>
                    <Setter Property="BorderBrush" Value="#C3E6CB"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                            <Setter Property="Background" Value="#F8D7DA"/>
                            <Setter Property="BorderBrush" Value="#F5C6CB"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <TextBlock Text="{Binding ResultMessage}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SuggestedAction}" Foreground="#721C24" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>