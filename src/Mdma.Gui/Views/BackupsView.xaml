<UserControl x:Class="Mdma.Gui.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Mdma.Core;assembly=Mdma.Core">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title + Filter + Refresh -->
            <RowDefinition Height="*"/>    <!-- Backups DataGrid -->
            <RowDefinition Height="Auto"/> <!-- Notice Card -->
            <RowDefinition Height="Auto"/> <!-- Action Button -->
            <RowDefinition Height="Auto"/> <!-- Result Banner -->
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0">
                <TextBlock Text="Backup Snapshots" FontSize="22" FontWeight="Bold" Foreground="#212529"/>
                <TextBlock Text="Automatic safety snapshots taken before download manager mutations" Foreground="#6C757D" FontSize="13" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#495057"/>
                <ComboBox SelectedValue="{Binding SelectedTargetFilter}" SelectedValuePath="Tag" Width="110" Margin="0,0,10,0" Padding="8,5">
                    <ComboBoxItem Content="All Apps" Tag="{x:Null}"/>
                    <ComboBoxItem Content="NDM Only" Tag="{x:Static core:TargetApp.NDM}"/>
                    <ComboBoxItem Content="JD2 Only" Tag="{x:Static core:TargetApp.JD2}"/>
                </ComboBox>
                <Button Content="🔄 Refresh" Command="{Binding RefreshCommand}"
                        Padding="12,6" Background="#2B2D42" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- Backups DataGrid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}"
                  AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" Background="White" RowHeaderWidth="0"
                  CanUserSortColumns="True" SelectionMode="Single" Margin="0,0,0,15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="TARGET" Binding="{Binding Target}" Width="80"/>
                <DataGridTextColumn Header="SNAPSHOT ID" Binding="{Binding Id}" Width="260"/>
                <DataGridTextColumn Header="CREATED AT (LOCAL)" Binding="{Binding FormattedCreatedAt}" Width="160"/>
                <DataGridTextColumn Header="STORAGE PATH" Binding="{Binding StoragePath}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Notice Card -->
        <Border Grid.Row="2" Background="#FFF3CD" BorderBrush="#FFEEBA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,15">
            <TextBlock Foreground="#856404" FontSize="12" TextWrapping="Wrap">
                ⚠️ <Run FontWeight="Bold">Revert Warning:</Run> Restoring a snapshot will overwrite the destination download manager's current database/configuration with the snapshot's state. Ensure the target download manager is closed before restoring.
            </TextBlock>
        </Border>

        <!-- Action Button -->
        <Button Grid.Row="3" Content="⏪ Restore Selected Snapshot" Command="{Binding RevertSelectedCommand}"
                Padding="20,10" Background="#2B2D42" Foreground="White" BorderThickness="0"
                FontWeight="Bold" FontSize="14" HorizontalAlignment="Left" Cursor="Hand" Margin="0,0,0,15"/>

        <!-- Result Banner -->
        <Border Grid.Row="4" CornerRadius="6" Padding="15" VerticalAlignment="Top"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#D4EDDA"/>
                    <Setter Property="BorderBrush" Value="#C3E6CB"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                            <Setter Property="Background" Value="#F8D7DA"/>
                            <Setter Property="BorderBrush" Value="#F5C6CB"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <TextBlock Text="{Binding ResultMessage}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SuggestedAction}" Foreground="#721C24" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>