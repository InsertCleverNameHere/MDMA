<UserControl x:Class="Mdma.Gui.Views.ConvertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Mdma.Core;assembly=Mdma.Core">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="Auto"/> <!-- Source Task Summary Card -->
            <RowDefinition Height="Auto"/> <!-- Destination App Card -->
            <RowDefinition Height="Auto"/> <!-- Backup Confirmation Warning Card -->
            <RowDefinition Height="Auto"/> <!-- Progress Card -->
            <RowDefinition Height="Auto"/> <!-- Action Button -->
            <RowDefinition Height="*"/>    <!-- Result Banner -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Convert Task (Same-Machine)" FontSize="22" FontWeight="Bold" Foreground="#212529"/>
            <TextBlock Text="Migrate a download task directly from one download manager to another" Foreground="#6C757D" FontSize="13"/>
        </StackPanel>

        <!-- Source Task Summary Card -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="SOURCE TASK" FontSize="11" FontWeight="Bold" Foreground="#6C757D" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Task.Filename}" FontSize="16" FontWeight="SemiBold" Foreground="#212529"/>
                        <TextBlock Text="{Binding Task.Url}" Foreground="#6C757D" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Task.Source}" FontWeight="Bold" Foreground="#2B2D42" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Task.StatusText}" Foreground="#495057" FontSize="12" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Destination App Selector Card -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="DESTINATION DOWNLOAD MANAGER" FontSize="11" FontWeight="Bold" Foreground="#6C757D" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Neat Download Manager (NDM)" IsChecked="{Binding TargetApp, Converter={x:Null}, ConverterParameter={x:Static core:TargetApp.NDM}}"
                                 GroupName="ConvertTargetGroup" Margin="0,0,25,0" FontWeight="SemiBold"/>
                    <RadioButton Content="JDownloader 2 (JD2)" GroupName="ConvertTargetGroup" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Backup Notice Card -->
        <Border Grid.Row="3" Background="#E2E3E5" BorderBrush="#D6D8D9" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,15">
            <TextBlock Foreground="#383D41" FontSize="12" TextWrapping="Wrap">
                🛡️ <Run FontWeight="Bold">Automatic Backup Protection:</Run> MDMA will snapshot the destination download manager's state to your working root backups directory before committing any files.
            </TextBlock>
        </Border>

        <!-- Progress Card -->
        <Border Grid.Row="4" Background="White" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15"
                Visibility="{Binding IsConverting, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0:F0}%'}" DockPanel.Dock="Right" FontWeight="Bold" Foreground="#2B2D42"/>
                    <TextBlock Text="{Binding ProgressStage}" FontWeight="SemiBold" Foreground="#212529"/>
                </DockPanel>
                <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" IsIndeterminate="False"/>
                <TextBlock Text="{Binding ProgressDetail}" Foreground="#6C757D" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Convert Action Button -->
        <Button Grid.Row="5" Content="⚡ Convert Task Now" Command="{Binding ConvertCommand}"
                Padding="20,10" Background="#2B2D42" Foreground="White" BorderThickness="0"
                FontWeight="Bold" FontSize="14" HorizontalAlignment="Left" Cursor="Hand" Margin="0,0,0,15"/>

        <!-- Result Banner -->
        <Border Grid.Row="6" CornerRadius="6" Padding="15" VerticalAlignment="Top"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#D4EDDA"/>
                    <Setter Property="BorderBrush" Value="#C3E6CB"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                            <Setter Property="Background" Value="#F8D7DA"/>
                            <Setter Property="BorderBrush" Value="#F5C6CB"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <TextBlock Text="{Binding ResultMessage}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SuggestedAction}" Foreground="#721C24" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>