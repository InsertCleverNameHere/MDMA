<UserControl x:Class="Mdma.Gui.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Mdma.Core;assembly=Mdma.Core">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="Auto"/> <!-- Package File Card -->
            <RowDefinition Height="Auto"/> <!-- Target App Selector Card -->
            <RowDefinition Height="Auto"/> <!-- Progress Card -->
            <RowDefinition Height="Auto"/> <!-- Action Button -->
            <RowDefinition Height="*"/>    <!-- Result Banner -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Import .mdma Package" FontSize="22" FontWeight="Bold" Foreground="#212529"/>
            <TextBlock Text="Load and inject a .mdma package file into a download manager" Foreground="#6C757D" FontSize="13"/>
        </StackPanel>

        <!-- Package File Picker Card -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="SELECT .MDMA PACKAGE FILE" FontSize="11" FontWeight="Bold" Foreground="#6C757D" Margin="0,0,0,8"/>
                <DockPanel>
                    <Button Content="Browse..." Click="BrowsePackage_Click" DockPanel.Dock="Right" Padding="15,6" Background="#6C757D" Foreground="White" BorderThickness="0" Margin="10,0,0,0" Cursor="Hand"/>
                    <TextBox Text="{Binding PackageFilePath, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Target App Selector Card -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="DESTINATION DOWNLOAD MANAGER" FontSize="11" FontWeight="Bold" Foreground="#6C757D" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Neat Download Manager (NDM)" IsChecked="{Binding TargetApp, Converter={x:Null}, ConverterParameter={x:Static core:TargetApp.NDM}}"
                                 GroupName="TargetAppGroup" Margin="0,0,25,0" FontWeight="SemiBold"/>
                    <RadioButton Content="JDownloader 2 (JD2)" GroupName="TargetAppGroup" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Progress Card -->
        <Border Grid.Row="3" Background="White" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15"
                Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0:F0}%'}" DockPanel.Dock="Right" FontWeight="Bold" Foreground="#2B2D42"/>
                    <TextBlock Text="{Binding ProgressStage}" FontWeight="SemiBold" Foreground="#212529"/>
                </DockPanel>
                <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" IsIndeterminate="False"/>
                <TextBlock Text="{Binding ProgressDetail}" Foreground="#6C757D" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Import Action Button -->
        <Button Grid.Row="4" Content="📥 Import Package" Command="{Binding ImportCommand}"
                Padding="20,10" Background="#2B2D42" Foreground="White" BorderThickness="0"
                FontWeight="Bold" FontSize="14" HorizontalAlignment="Left" Cursor="Hand" Margin="0,0,0,15"/>

        <!-- Result Banner -->
        <Border Grid.Row="5" CornerRadius="6" Padding="15" VerticalAlignment="Top"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#D4EDDA"/>
                    <Setter Property="BorderBrush" Value="#C3E6CB"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                            <Setter Property="Background" Value="#F8D7DA"/>
                            <Setter Property="BorderBrush" Value="#F5C6CB"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <TextBlock Text="{Binding ResultMessage}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SuggestedAction}" Foreground="#721C24" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>