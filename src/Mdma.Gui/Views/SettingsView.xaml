<UserControl x:Class="Mdma.Gui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="Auto"/> <!-- Working Directory Card -->
            <RowDefinition Height="Auto"/> <!-- Maintenance / Orphan Sweep Card -->
            <RowDefinition Height="Auto"/> <!-- Application Logs Card -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Settings &amp; Maintenance" FontSize="22" FontWeight="Bold" Foreground="#212529"/>
            <TextBlock Text="View working root storage configuration, logs, and temporary file cleanup" Foreground="#6C757D" FontSize="13" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Working Directory Card -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="WORKING DIRECTORY" FontSize="11" FontWeight="Bold" Foreground="#6C757D" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding WorkingRootPath}" FontSize="14" FontWeight="SemiBold" Foreground="#212529" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding StorageTypeDescription}" Foreground="#495057" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Maintenance / Orphan Sweep Card -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="TEMPORARY STAGING CLEANUP" FontSize="11" FontWeight="Bold" Foreground="#6C757D" Margin="0,0,0,8"/>
                <TextBlock Text="Sweep orphaned temporary packages and staging folders left in .mdma-tmp from interrupted operations."
                           Foreground="#495057" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <DockPanel>
                    <Button Content="🧹 Sweep Orphaned Files" Command="{Binding SweepOrphansCommand}"
                            Padding="15,8" Background="#2B2D42" Foreground="White" BorderThickness="0"
                            FontWeight="SemiBold" Cursor="Hand" HorizontalAlignment="Left"/>
                </DockPanel>
                
                <TextBlock Text="{Binding SweepSummary}" Foreground="#28A745" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,0"
                           Visibility="{Binding HasSweepResult, Converter={StaticResource BoolToVis}}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Application Logs Card -->
        <Border Grid.Row="3" Background="White" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="APPLICATION LOGS" FontSize="11" FontWeight="Bold" Foreground="#6C757D" Margin="0,0,0,8"/>
                <TextBlock Text="Structured operational log files (.log JSON lines) stored in your working root logs folder."
                           Foreground="#495057" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <Button Content="📂 Open Logs Directory" Command="{Binding OpenLogsFolderCommand}"
                        Padding="15,8" Background="#4A4E69" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>