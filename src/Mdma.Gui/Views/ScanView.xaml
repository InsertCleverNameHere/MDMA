<UserControl x:Class="Mdma.Gui.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Mdma.Core;assembly=Mdma.Core"
             xmlns:vm="clr-namespace:Mdma.Gui.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header + Refresh Button -->
            <RowDefinition Height="Auto"/> <!-- App Status Cards -->
            <RowDefinition Height="*"/>    <!-- Task DataGrid -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0">
                <TextBlock Text="Scan Download Tasks" FontSize="22" FontWeight="Bold" Foreground="#212529"/>
                <TextBlock Text="Discovered tasks from Neat Download Manager and JDownloader 2" Foreground="#6C757D" FontSize="13" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="⚡ Convert Selected" Command="{Binding ConvertSelectedCommand}"
                        Padding="12,8" Background="#3A5A40" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0"/>
                <Button Content="🚀 Export Selected" Command="{Binding ExportSelectedCommand}"
                        Padding="12,8" Background="#4A4E69" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0"/>
                <Button Content="🔄 Refresh Tasks" Command="{Binding RefreshCommand}"
                        Padding="12,8" Background="#2B2D42" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- App Status Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- NDM Card -->
            <Border Grid.Column="0" Background="White" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="6" Padding="12">
                <DockPanel>
                    <Button Content="Browse..." Click="BrowseNdm_Click" DockPanel.Dock="Right"
                            Padding="10,4" Background="#6C757D" Foreground="White" BorderThickness="0" FontSize="12" Cursor="Hand"/>
                    <TextBlock Text="{Binding NdmStatus.StatusText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#212529" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- JD2 Card -->
            <Border Grid.Column="2" Background="White" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="6" Padding="12">
                <DockPanel>
                    <Button Content="Browse..." Click="BrowseJd2_Click" DockPanel.Dock="Right"
                            Padding="10,4" Background="#6C757D" Foreground="White" BorderThickness="0" FontSize="12" Cursor="Hand"/>
                    <TextBlock Text="{Binding Jd2Status.StatusText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#212529" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Tasks DataGrid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}"
                  AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" Background="White" RowHeaderWidth="0"
                  CanUserSortColumns="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="APP" Binding="{Binding Source}" Width="70"/>
                <DataGridTextColumn Header="ID" Binding="{Binding NativeId}" Width="80"/>
                <DataGridTextColumn Header="FILENAME" Binding="{Binding Filename}" Width="*"/>
                
                <DataGridTemplateColumn Header="PROGRESS" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="5,0">
                                <ProgressBar Value="{Binding PercentComplete, Mode=OneWay}" Minimum="0" Maximum="100" Height="14"/>
                                <TextBlock Text="{Binding PercentComplete, StringFormat='{}{0:F1}%'}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#212529"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="STATUS" Binding="{Binding StatusText}" Width="120"/>
                <DataGridTextColumn Header="RESUMABLE" Binding="{Binding Resumable}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>